{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "Loki data source holding cannonball-se game event logs",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    },
    {
      "name": "DS_TEMPO",
      "label": "Tempo",
      "description": "Tempo data source holding cannonball-se game traces (drives the Session picker)",
      "type": "datasource",
      "pluginId": "tempo",
      "pluginName": "Tempo"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "13.0.0"
    },
    {
      "type": "datasource",
      "id": "loki",
      "name": "Loki",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "grafana-graphviz-panel",
      "name": "Graphviz",
      "version": ""
    },
    {
      "type": "panel",
      "id": "dalvany-image-panel",
      "name": "Dynamic image",
      "version": ""
    },
    {
      "type": "datasource",
      "id": "tempo",
      "name": "Tempo",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Detailed view of one Cannonball-SE game. The Session picker is powered by Tempo (label_values on the session_label span attribute, sorted newest-first, defaults to the latest game); the Loki panels filter by that same session_label, so it is exact at ANY time range. Import prompts for both a Loki and a Tempo data source. Requires community plugins grafana-graphviz-panel and dalvany-image-panel.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "type": "logs",
      "title": "Latest game",
      "description": "The selected game. Pick a run from the Session dropdown (top) \u2014 it's sorted newest-first, so the latest game is the top entry and is selected by default.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "queryType": "range",
          "maxLines": 1,
          "expr": "{service_name=\"cannonball-se\"} | session_label=\"$session\" | event=\"game.session.start\" | line_format \"{{.player_initials}}  mode={{.game_mode}}  music={{.music_selection}}  trace_id={{.trace_id}}\""
        }
      ]
    },
    {
      "type": "stat",
      "title": "Session state",
      "description": "For the selected (newest) session: starts \u2212 ends. 1 = IN PROGRESS (started, no end yet), 0 = FINISHED. Per-session, so multiple games in range no longer confuse it.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 5
      },
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "\u2014 NO GAME \u2014",
                  "color": "text",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 100000,
                "result": {
                  "text": "IN PROGRESS",
                  "color": "yellow",
                  "index": 1
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": -100000,
                "to": 0,
                "result": {
                  "text": "FINISHED",
                  "color": "green",
                  "index": 2
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "(sum(count_over_time({service_name=\"cannonball-se\"} | event=\"game.session.start\" | session_label=\"$session\" [$__range])) or vector(0)) - (sum(count_over_time({service_name=\"cannonball-se\"} | event=\"game.session.end\" | session_label=\"$session\" [$__range])) or vector(0))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Stage reached",
      "description": "Highest stage_number seen across any event in this session. Works for in-progress games (does not rely on final_stage from the end event).",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 5
      },
      "id": 14,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 5,
          "color": {
            "mode": "continuous-GrYlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "max(max_over_time({service_name=\"cannonball-se\"} | session_label=\"$session\" | unwrap stage_number [$__range]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Off-road",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 5
      },
      "id": 4,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "sum(count_over_time({service_name=\"cannonball-se\"} | event=\"game.off_road\" | session_label=\"$session\" [$__range]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Avg speed (kph)",
      "description": "Mean speed_kph across this session's events. NOTE: speed_kph is only logged on crash / off-road / stage-start / route / overtake events, so this is a sampled average weighted toward eventful moments, not a true whole-lap mean.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 5
      },
      "id": 15,
      "fieldConfig": {
        "defaults": {
          "unit": "velocitykmh",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "avg(avg_over_time({service_name=\"cannonball-se\"} | session_label=\"$session\" | unwrap speed_kph [$__range]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Top speed (kph)",
      "description": "Highest speed_kph seen across any event in this session.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 5
      },
      "id": 6,
      "fieldConfig": {
        "defaults": {
          "unit": "velocitykmh",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "max(max_over_time({service_name=\"cannonball-se\"} | session_label=\"$session\" | unwrap speed_kph [$__range]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Final score",
      "description": "final_score from game.session.end (empty while the game is still in progress).",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 5
      },
      "id": 7,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "max(max_over_time({service_name=\"cannonball-se\"} | event=\"game.session.end\" | session_label=\"$session\" | unwrap final_score [$__range]))"
        }
      ]
    },
    {
      "type": "barchart",
      "title": "Crashes by type",
      "description": "Crash count grouped by crash_type (bump / spin / flip) for the selected session.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "id": 3,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80
          },
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "showValue": "auto",
        "stacking": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "queryType": "instant",
          "legendFormat": "{{crash_type}}",
          "expr": "sum by (crash_type) (count_over_time({service_name=\"cannonball-se\"} | event=\"game.crash\" | session_label=\"$session\" [$__range]))"
        }
      ]
    },
    {
      "type": "barchart",
      "title": "Overtakes by vehicle type",
      "description": "Overtake count grouped by vehicle_type for the selected session.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 9
      },
      "id": 5,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80
          },
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "showValue": "auto",
        "stacking": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "queryType": "instant",
          "legendFormat": "{{vehicle_type}}",
          "expr": "sum by (vehicle_type) (count_over_time({service_name=\"cannonball-se\"} | event=\"game.vehicle_overtake\" | session_label=\"$session\" [$__range]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Score progression (per stage)",
      "description": "score_end recorded at each game.stage.end for this session.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 9
      },
      "id": 9,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 10,
            "showPoints": "always",
            "pointSize": 6
          },
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "queryType": "range",
          "legendFormat": "score",
          "expr": "max_over_time({service_name=\"cannonball-se\"} | event=\"game.stage.end\" | session_label=\"$session\" | unwrap score_end [$__auto])"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Session result (end event)",
      "description": "The game.session.end line for the selected session \u2014 completion status, final score and stage. Blank while a game is in progress.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "id": 8,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "queryType": "range",
          "maxLines": 1,
          "expr": "{service_name=\"cannonball-se\"} | event=\"game.session.end\" | session_label=\"$session\" | line_format \"result={{.completion_status}}  final_score={{.final_score}}  final_stage={{.final_stage}}  clean={{.longest_clean_seconds}}s\""
        }
      ]
    },
    {
      "type": "logs",
      "title": "Crashes this game",
      "description": "Every game.crash for the selected session, with stage, crash type and speed.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "id": 10,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "queryType": "range",
          "expr": "{service_name=\"cannonball-se\"} | event=\"game.crash\" | session_label=\"$session\" | line_format \"Stage {{.stage_number}}: {{.crash_type}} @ {{.speed_kph}}kph (score {{.score}})\""
        }
      ]
    },
    {
      "type": "logs",
      "title": "Full event timeline (this game)",
      "description": "Every event for the selected session in time order \u2014 the complete story of one game.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "id": 11,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Ascending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "queryType": "range",
          "expr": "{service_name=\"cannonball-se\"} | session_label=\"$session\" | line_format \"{{.event}}  stage={{.stage_number}}  speed={{.speed_kph}}  score={{.score}}\""
        }
      ]
    },
    {
      "type": "grafana-graphviz-panel",
      "title": "Route taken (map)",
      "description": "The OutRun map. Nodes visited by the selected session are populated with a visit count via the panel's node-id matching (node id = stage_id). Every stage 1-5 emits game.stage.start, including Coconut Beach (stage_id 0), so the whole route populates. Tip: add a Node override coloured by the injected value to fully highlight the path.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "id": 20,
      "options": {
        "inputMode": "code",
        "dotDiagram": "digraph OutRun {\n  rankdir=LR;\n  bgcolor=\"transparent\";\n  node [shape=box, style=\"rounded,filled\", fontname=\"Helvetica\", fontsize=11, color=\"#33333322\", penwidth=1.5];\n  edge [arrowsize=0.7, color=\"#9e9e9e\", penwidth=1.2];\n\n  // Stage 1\n  \"0\"  [label=\"Coconut Beach\\n${visits}\",   fillcolor=\"#e53935\", fontcolor=\"white\"];\n\n  // Stage 2  (top = most-left = higher id)\n  \"9\"  [label=\"Gateway\\n${visits}\",         fillcolor=\"#fb8c00\", fontcolor=\"white\"];\n  \"8\"  [label=\"Devil's Canyon\\n${visits}\",  fillcolor=\"#fb8c00\", fontcolor=\"white\"];\n\n  // Stage 3\n  \"18\" [label=\"Desert\\n${visits}\",          fillcolor=\"#fdd835\", fontcolor=\"black\"];\n  \"17\" [label=\"Alps\\n${visits}\",            fillcolor=\"#fdd835\", fontcolor=\"black\"];\n  \"16\" [label=\"Cloudy Mountain\\n${visits}\", fillcolor=\"#fdd835\", fontcolor=\"black\"];\n\n  // Stage 4\n  \"27\" [label=\"Wilderness\\n${visits}\",      fillcolor=\"#7cb342\", fontcolor=\"white\"];\n  \"26\" [label=\"Old Capital\\n${visits}\",     fillcolor=\"#7cb342\", fontcolor=\"white\"];\n  \"25\" [label=\"Wheat Field\\n${visits}\",     fillcolor=\"#7cb342\", fontcolor=\"white\"];\n  \"24\" [label=\"Seaside Town\\n${visits}\",    fillcolor=\"#7cb342\", fontcolor=\"white\"];\n\n  // Stage 5 (goals)\n  \"36\" [label=\"Vineyard\\n${visits}\",        fillcolor=\"#1e88e5\", fontcolor=\"white\"];\n  \"35\" [label=\"Death Valley\\n${visits}\",    fillcolor=\"#1e88e5\", fontcolor=\"white\"];\n  \"34\" [label=\"Desolation Hill\\n${visits}\", fillcolor=\"#1e88e5\", fontcolor=\"white\"];\n  \"33\" [label=\"Autobahn\\n${visits}\",        fillcolor=\"#1e88e5\", fontcolor=\"white\"];\n  \"32\" [label=\"Lakeside\\n${visits}\",        fillcolor=\"#1e88e5\", fontcolor=\"white\"];\n\n  // Keep each stage in its own column\n  { rank=same; \"9\"; \"8\"; }\n  { rank=same; \"18\"; \"17\"; \"16\"; }\n  { rank=same; \"27\"; \"26\"; \"25\"; \"24\"; }\n  { rank=same; \"36\"; \"35\"; \"34\"; \"33\"; \"32\"; }\n\n  // Pin vertical order within a column: top = higher id (= more left turns)\n  \"9\"  -> \"8\"  [style=invis];\n  \"18\" -> \"17\" -> \"16\" [style=invis];\n  \"27\" -> \"26\" -> \"25\" -> \"24\" [style=invis];\n  \"36\" -> \"35\" -> \"34\" -> \"33\" -> \"32\" [style=invis];\n\n  // Route edges: down/right keeps position, up/left = position+1 (higher id)\n  \"0\"  -> \"8\";  \"0\"  -> \"9\";\n  \"8\"  -> \"16\"; \"8\"  -> \"17\";\n  \"9\"  -> \"17\"; \"9\"  -> \"18\";\n  \"16\" -> \"24\"; \"16\" -> \"25\";\n  \"17\" -> \"25\"; \"17\" -> \"26\";\n  \"18\" -> \"26\"; \"18\" -> \"27\";\n  \"24\" -> \"32\"; \"24\" -> \"33\";\n  \"25\" -> \"33\"; \"25\" -> \"34\";\n  \"26\" -> \"34\"; \"26\" -> \"35\";\n  \"27\" -> \"35\"; \"27\" -> \"36\";\n}",
        "layoutEngine": "dot",
        "rankDirection": "LR",
        "splineType": "true",
        "nodeOverrides": [],
        "edgeOverrides": [],
        "namedThresholds": []
      },
