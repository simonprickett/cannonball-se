{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "Loki data source holding cannonball-se game event logs",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "13.0.0"
    },
    {
      "type": "datasource",
      "id": "loki",
      "name": "Loki",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Per-run leaderboards (Hall of Fame) for Cannonball-SE. Each board ranks the top 10 game runs (one row per session / trace_id, labelled by player_initials) by a metric, over the selected time range. NOTE: player_initials is not a unique identity \u2014 the same initials from different people collapse together, which is why ranking is per-run. Tables are best-effort sorted descending; click a column header to re-sort. Bounded by Loki retention and the time picker.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "table",
      "title": "\ud83c\udfc6 Top Scores",
      "description": "Highest final_score per game run.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "topk(10, max by (trace_id, player_initials) (max_over_time({service_name=\"cannonball-se\"} | event=\"game.session.end\" | player_initials=~\"$player\" | unwrap final_score [$__range])))"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "tsNs": true,
              "trace_id": true,
              "id": true,
              "labels": true,
              "Line": true
            },
            "renameByName": {
              "player_initials": "Player",
              "Value": "Score"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Score",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "type": "table",
