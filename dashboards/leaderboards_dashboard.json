  "templating": {
    "list": [
      {
        "name": "DS_LOKI",
        "label": "Loki data source",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 2,
        "refresh": 1,
        "regex": ""
      },
      {
        "name": "player",
        "label": "Player initials (regex)",
