// Grafana Alloy config for CannonBall-SE on the Raspberry Pi.
//
// Phase 1: pass-through. The game sends OTLP (traces + logs) to Alloy on localhost,
// and Alloy forwards both to Grafana Cloud unchanged. Credentials live here (via
// environment variables), not in the game's config.xml.
//
// Install path: /etc/alloy/config.alloy
// Environment:  /etc/default/alloy (see alloy.env.example)

// ---- Receive from the game -------------------------------------------------

otelcol.receiver.otlp "game" {
  // HTTP only, loopback only. The game posts to /v1/traces and /v1/logs.
  http {
    endpoint = "127.0.0.1:4318"
  }

  output {
    traces = [otelcol.processor.batch.default.input]
    logs   = [otelcol.processor.batch.default.input]
  }
}

// ---- Batch -----------------------------------------------------------------

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlphttp.grafana_cloud.input]
    logs   = [otelcol.exporter.otlphttp.grafana_cloud.input]
  }
}

// ---- Send to Grafana Cloud -------------------------------------------------

otelcol.auth.basic "grafana_cloud" {
  username = sys.env("GCLOUD_INSTANCE_ID")
  password = sys.env("GCLOUD_TOKEN")
}

otelcol.exporter.otlphttp "grafana_cloud" {
  client {
    // Base URL only, e.g. https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
    // The exporter appends /v1/traces and /v1/logs itself, so do NOT end this with /v1
    // (unlike the game's config.xml <otlp_endpoint>, which does end /v1).
    endpoint = sys.env("GCLOUD_OTLP_ENDPOINT")
    auth     = otelcol.auth.basic.grafana_cloud.handler
  }
}
