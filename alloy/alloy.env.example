# Copy to /etc/default/alloy on the Pi and fill in the values.
# Do NOT commit a filled-in copy.
#
# CONFIG_FILE and CUSTOM_ARGS are read by the Alloy systemd unit; keep them if the
# packaged /etc/default/alloy already defines them and just append the GCLOUD_* lines.

CONFIG_FILE="/etc/alloy/config.alloy"
CUSTOM_ARGS=""

# Base OTLP gateway URL for your stack (no /v1/... suffix). Region must match the stack.
GCLOUD_OTLP_ENDPOINT="https://otlp-gateway-prod-<region>.grafana.net/otlp"

# OTLP instance ID from the stack's OpenTelemetry connection details (numeric).
GCLOUD_INSTANCE_ID="<instance id>"

# Cloud Access Policy token (glc_...) with the traces:write and logs:write scopes.
GCLOUD_TOKEN="glc_<token>"
