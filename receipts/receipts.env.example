# Copy to receipts.env (git-ignored) and load with: set -a; . receipts.env; set +a
# or point a systemd unit's EnvironmentFile= at it.

# Print a QR code linking to the game's dashboard page. Off by default.
RECEIPT_QR_ENABLED=false

# QR mode: auto (default; native when the link is short enough, else bitmap), native (printer's own QR command,
# fast but the CSN-A2 rejected a 147-character link), or bitmap (raster image, slow, any length).
# RECEIPT_QR_MODE=auto
# Longest link (characters) sent to the native QR in auto mode. 29 is the largest length verified on the printer.
# RECEIPT_QR_NATIVE_MAX_CHARS=29

# Bitmap QR module size in dots (width x height). Default 3 x 3. If the printed QR comes out taller than wide,
# lower the height or raise the width until it is square, e.g. width 4, height 3.
# RECEIPT_QR_BOX_WIDTH=3
# RECEIPT_QR_BOX_HEIGHT=3

# Public Grafana base URL (no trailing slash). Required when the QR is enabled.
# RECEIPT_DASHBOARD_BASE_URL=https://play.grafana.org

# Dashboard path (uid and slug). Change if the public variant differs.
# RECEIPT_DASHBOARD_PATH=/d/cannonball-recent-games/recent-games

# Minutes before the game's end that the link's time range starts.
# RECEIPT_QR_WINDOW_MINUTES=15

# Optional logo image (PNG best; any format Pillow reads), printed instead of the CANNONBALL title text.
# RECEIPT_LOGO_PATH=assets/logo.png
# RECEIPT_LOGO_WIDTH=320

# Blank lines fed after the receipt so it clears the tear bar (no cutter).
# RECEIPT_FEED_LINES=8
